# Normaliza finales de línea en todo el texto
* text=auto eol=lf

# Las transcripciones son texto plano UTF-8
*.md   text diff=markdown
*.txt  text
*.srt  text
*.vtt  text
*.json text

# Los thumbnails son binarios (sí se versionan, pesan poco)
*.jpg binary
*.jpeg binary
*.png binary

